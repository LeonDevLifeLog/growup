<view class="page">
  <view class="eyebrow">YOUR OWN GROWING SPACE</view><view class="title">你好，慢慢成长的你。</view>
  <view wx:if="{{loading}}" class="state">正在读取资料…</view>
  <view wx:if="{{error}}" class="error">{{error}}<button class="button-outline button-small spaced" bindtap="load">重新加载</button></view>
  <block wx:if="{{!loading && !error}}"><view class="profile-card spaced"><view class="profile-avatar">{{initial}}</view><view class="profile-name">{{user.name}}</view><view class="small">{{user.schoolName}}</view><text class="pill spaced">{{user.regionName}} · 学生成长空间</text></view>
  <view class="card"><view class="row info-row"><text class="muted">我的账号</text><text selectable>{{user.account}}</text></view><view class="row info-row"><text class="muted">所属学校</text><text>{{user.schoolName}}</text></view><view class="row info-row"><text class="muted">所属区域</text><text>{{user.regionName}}</text></view></view></block>
  <view class="menu card"><view class="menu-item" bindtap="records"><text>✧　我的星图与记录</text><text>→</text></view><view class="menu-item" bindtap="service"><text>♡　服务需求与处理状态</text><text>→</text></view><view class="menu-item" bindtap="password"><text>⚿　修改密码</text><text>→</text></view><view class="menu-item" bindtap="privacy"><text>▧　我的数据与隐私</text><text>→</text></view><view class="menu-item" bindtap="help"><text>☂　我需要一点支持</text><text>→</text></view><view class="menu-item" bindtap="about"><text>◌　关于成长健研社</text><text>→</text></view></view>
  <button class="button-outline spaced" bindtap="logout" loading="{{loggingOut}}" disabled="{{loggingOut}}">退出登录</button>
  <view class="safe-note">成长，不是一场比赛。<text>{{'\n'}}</text>你可以按自己的节奏，慢慢来。</view>
</view>
