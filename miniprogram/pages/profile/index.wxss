.profile-card {
  background:#e8eedc;
  border-radius:32rpx;
  text-align:center;
  padding:42rpx 24rpx;
  margin-bottom:24rpx;
}

.profile-avatar {
  display:flex;
  align-items:center;
  justify-content:center;
  width:118rpx;
  height:118rpx;
  border-radius:50%;
  background:#d5e7a7;
  color:#245c45;
  font-size:48rpx;
  margin:0 auto 20rpx;
}

.profile-name {
  font-size:38rpx;
  font-weight:600;
  margin-bottom:6rpx;
}

.profile-card .pill {
  background:#f8faef;
}

.info-row {
  padding:16rpx 0;
  font-size:25rpx;
}

.info-row>text:last-child {
  text-align:right;
  max-width:70%;
  word-break:break-word;
}

.menu {
  padding:8rpx 28rpx;
}

.menu-item {
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:28rpx 0;
  border-bottom:1rpx solid #edf0e7;
  font-size:27rpx;
}

.menu-item:last-child {
  border:0;
}

.menu-item>text:last-child {
  color:#8a9b7b;
}
