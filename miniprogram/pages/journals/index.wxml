<view class="page">
  <view class="row"><view class="eyebrow">MY LITTLE CONSTELLATION</view><view class="tip-line"><text class="pill">仅自己可见</text><text class="tip-btn" data-tip="journalPrivacy" bindtap="showTip">?</text></view></view>
  <view class="title">把日常，连成星图。</view><view class="subtitle">为心情、关系与成长贴上自己的标签。<text>{{'\n'}}</text>看见生活中，哪些片段总会一起发光。</view>
  <button class="spaced" bindtap="write" disabled="{{submitting}}">＋ 写一篇星图日记</button>
  <view class="journal-tabs"><view class="journal-tab {{tab === 'map' ? 'active-tab' : ''}}" data-tab="map" bindtap="changeTab">成长星图</view><view class="journal-tab {{tab === 'journals' ? 'active-tab' : ''}}" data-tab="journals" bindtap="changeTab">日记 {{journals.length}}</view><view class="journal-tab {{tab === 'checkins' ? 'active-tab' : ''}}" data-tab="checkins" bindtap="changeTab">心情 {{checkins.length}}</view></view>
  <view wx:if="{{error}}" class="error">{{error}}<button class="button-outline button-small spaced" bindtap="load">重新加载</button></view>
  <view wx:if="{{success}}" class="notice">{{success}}</view>
  <view wx:if="{{loading}}" class="state">正在点亮你的星图…</view>
  <block wx:elif="{{tab === 'map'}}">
    <view class="map-stats"><view><text>{{mapStats.total || 0}}</text><view class="small">篇日记</view></view><view><text>{{mapStats.last7Days || 0}}</text><view class="small">近 7 天</view></view><view><text>{{mapStats.streak || 0}}</text><view class="small">连续记录天数</view></view></view>
    <view wx:if="{{mapNodes.length}}" class="relationship-map"><view wx:for="{{mapEdges}}" wx:key="key" class="map-edge" style="left:{{item.x}}rpx;top:{{item.y}}rpx;width:{{item.length}}rpx;transform:rotate({{item.angle}}deg)"></view><view wx:for="{{mapNodes}}" wx:key="id" class="map-node" style="left:{{item.x}}rpx;top:{{item.y}}rpx" data-tag="{{item.id}}" bindtap="selectTag"><view>{{item.count}}</view><text>{{item.label}}</text></view><view class="map-caption">标签在同一篇日记中出现，就会连成一条线</view></view>
    <view wx:else class="state"><view class="empty-icon">✧</view><view class="state-title">给日常加一个标签</view><view>写日记时加入“朋友”“学习”等标签，<text>{{'\n'}}</text>它们会在这里连成你的生活星图。</view></view>
    <view class="tip-line">星图怎么看<text class="tip-btn" data-tip="starmap" bindtap="showTip">?</text></view>
    <view class="card spaced"><view class="row"><view><view class="small">已记录日记心情均值<text class="tip-btn" data-tip="moodAverage" bindtap="showTip">?</text></view><view class="map-metric">{{mapStats.moodAverageLabel}} <text class="small">/ 5</text></view></view><view><view class="small">近期心情变化</view><view class="map-metric">{{mapStats.moodChangeLabel}}</view></view></view></view>
    <button class="button-light spaced" bindtap="generateImage" loading="{{imageBusy}}" disabled="{{imageBusy}}">生成我的星图图片</button><view wx:if="{{canvasVisible}}" class="canvas-preview spaced"><canvas canvas-id="starMapCanvas" class="star-map-canvas"></canvas></view><button wx:if="{{imagePath}}" class="spaced" bindtap="saveImage">保存星图图片到相册</button><view wx:if="{{imagePath}}" class="small spaced">图片保留标签关系，不包含日记正文。保存到相册前请确认这是你愿意保存和分享的私人内容。</view><view wx:if="{{connections.length}}" class="section-title">常常一起出现的片段</view><view wx:for="{{connections}}" wx:key="index" class="connection"><text>{{item.source}}　↔　{{item.target}}</text><text class="pill">{{item.weight}} 篇</text></view>
  </block>
  <block wx:elif="{{tab === 'journals'}}">
    <input class="field" value="{{query}}" bindinput="search" placeholder="搜索标题、文字、标签或目标"/>

    <view wx:if="{{!visibleJournals.length}}" class="state"><view class="empty-icon">✧</view><view class="state-title">{{query ? '还没有找到这段日常' : '第一颗星星，等你点亮'}}</view><view>{{query ? '试试其他文字，或清空搜索。' : '写下一个让你停留的小瞬间。'}}</view></view>
    <view class="card journal spaced" wx:for="{{visibleJournals}}" wx:key="id"><view class="row"><view class="small">✧ {{item.displayTime}}</view></view><view class="journal-title">{{item.title}}</view><view wx:if="{{item.moodLabel}}" class="pill">{{item.moodLabel}} · {{item.intensityLabel}}</view><view class="prewrap journal-content spaced">{{item.content}}</view><view class="spaced" wx:if="{{item.tags.length}}"><text class="chip" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this" data-tag="{{tag}}" bindtap="selectTag"># {{tag}}</text></view><view wx:if="{{item.goal}}" class="notice"><text class="small">下一步的小目标</text><view class="prewrap">{{item.goal}}</view></view><button class="button-outline button-small spaced" data-id="{{item.id}}" bindtap="remove" disabled="{{deleting}}">删除日记</button></view>
  </block>
  <block wx:else><view wx:if="{{!checkins.length}}" class="state"><view class="empty-icon">◌</view><view>还没有心情记录</view><button class="button-light spaced" bindtap="checkin">记录今天的心情</button></view><view class="card" wx:for="{{checkins}}" wx:key="id"><view class="row"><view class="row"><view class="mood-dot" style="background:{{item.color}}">{{item.score}}</view><view><view class="record-mood">{{item.moodName}}</view><view class="small">{{item.date}}</view></view></view><text class="small">{{item.score}} / 5</text></view><view wx:if="{{item.tags.length}}" class="spaced"><text class="chip" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text></view><view wx:if="{{item.note}}" class="prewrap muted spaced">{{item.note}}</view></view></block>
</view>
<view wx:if="{{editor}}" class="modal-mask" bindtap="closeEditor"><view class="sheet" catchtap="noop"><view class="row"><view class="section-title sheet-title">今天，我想记住……</view><text class="close" bindtap="closeEditor">×</text></view><scroll-view scroll-y class="sheet-scroll">
    <view><text class="chip {{entryMode === 'full' ? 'active' : ''}}" data-mode="full" bindtap="entryMode">完整日记</text><text class="chip {{entryMode === 'sentence' ? 'active' : ''}}" data-mode="sentence" bindtap="entryMode">一句话</text><text class="chip {{entryMode === 'mood' ? 'active' : ''}}" data-mode="mood" bindtap="entryMode">仅心情</text></view>
    <block wx:if="{{entryMode !== 'mood'}}"><text class="label">给这颗星星取个名字 <text class="small">（选填）</text></text><input class="field" value="{{title}}" data-field="title" bindinput="input" maxlength="80" placeholder="一个瞬间、一句心里话" disabled="{{submitting}}"/>
    <text class="label">只写给自己的日常</text><textarea class="field textarea" value="{{content}}" data-field="content" bindinput="input" maxlength="{{entryMode === 'sentence' ? 200 : 5000}}" placeholder="发生了什么？我有什么感受？" disabled="{{submitting}}"/><view class="count">{{content.length}} / {{entryMode === 'sentence' ? 200 : 5000}}</view></block>
    <text class="label">这段日常的心情 <text class="small">（选填）</text></text><picker mode="selector" range="{{moodNames}}" value="{{moodIndex}}" bindchange="moodChange" disabled="{{submitting}}"><view class="field row"><text>{{moodNames[moodIndex]}}</text><text>⌄</text></view></picker>
    <block wx:if="{{moodIndex}}"><text class="label">感受有多强烈？</text><picker mode="selector" range="{{intensityNames}}" value="{{intensityIndex}}" bindchange="intensityChange" disabled="{{submitting}}"><view class="field row"><text>{{intensityNames[intensityIndex]}}</text><text>⌄</text></view></picker></block>
    <text class="label">生活标签 <text class="small">（最多 6 个，逗号分隔）</text></text><input class="field" value="{{tagsText}}" data-field="tagsText" bindinput="input" maxlength="126" placeholder="例如：朋友，学习，小成就" disabled="{{submitting}}"/>
    <text class="label">下一步的小目标 <text class="small">（选填）</text></text><textarea class="field goal-field" value="{{goal}}" data-field="goal" bindinput="input" maxlength="200" placeholder="愿意为明天的自己，做一件什么小事？" disabled="{{submitting}}"/>
    <view wx:if="{{sheetError}}" class="error">{{sheetError}}</view>
</scroll-view><button class="spaced" bindtap="submit" disabled="{{submitting || (!content && !moodIndex)}}" loading="{{submitting}}">收藏这颗小星星 ✧</button></view></view>
