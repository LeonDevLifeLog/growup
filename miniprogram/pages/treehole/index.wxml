<view class="page">
  <view class="row"><view class="eyebrow">A SOFT PLACE TO LAND</view><text class="pill">{{user.regionName}}的树洞</text></view>
  <view class="title">有些心事，<text>{{'\n'}}</text>可以轻轻放在这里。</view><view class="subtitle">没有姓名，只有一颗愿意倾听的心。<text>{{'\n'}}</text>送一份温暖，也接住别人的小情绪。</view>
  <view class="notice">对同区域同学展示化名；平台保存关联以供审核追溯。投稿与回复先审后发，请勿留下姓名、学校、电话等个人信息。</view>
  <button bindtap="compose">＋ 写一张匿名纸条</button>
  <view class="tree-tabs"><text class="{{!mine ? 'selected-tab' : ''}}" data-mine="no" bindtap="setMine">树洞广场</text><text class="{{mine ? 'selected-tab' : ''}}" data-mine="yes" bindtap="setMine">我的纸条</text></view>
  <scroll-view scroll-x class="filters"><view class="filter-line"><text wx:for="{{filters}}" wx:key="*this" data-topic="{{item}}" bindtap="filter" class="chip {{topic === item ? 'active' : ''}}">{{item}}</text></view></scroll-view>
  <view wx:if="{{error}}" class="error">{{error}}<button class="button-outline button-small spaced" bindtap="load">重新加载</button></view>
  <view wx:if="{{loading}}" class="state">风正在捎来纸条…</view>
  <view wx:elif="{{!posts.length}}" class="state"><view class="empty-icon">☽</view><view class="state-title">{{mine ? '还没有你写下的纸条' : '这里还很安静'}}</view><view>{{mine ? '投稿后可以在这里看到审核状态。' : '可以先写下一点点想分享的心情。'}}</view></view>
  <block wx:else><view wx:for="{{posts}}" wx:key="id" class="card post"><view class="row"><view class="post-author"><view class="avatar">✿</view><view><view class="nickname">{{item.nickname}}</view><view class="small">{{item.displayTime}}</view></view></view><text class="topic">{{item.topic}}</text></view><view wx:if="{{mine}}" class="status small">{{item.statusText}}</view><view class="prewrap post-content">{{item.content}}</view><view class="post-actions" wx:if="{{item.status === 'approved'}}"><button class="action warm {{item.warmed ? 'warmed' : ''}}" data-id="{{item.id}}" bindtap="warm" disabled="{{item.warmed || actionBusy}}">♡ {{item.warmed ? '已送温暖' : '送温暖'}} {{item.warmCount}}</button><button class="action" data-id="{{item.id}}" bindtap="reply" disabled="{{actionBusy}}">回应 {{item.replies.length}}</button><button class="action report" data-id="{{item.id}}" bindtap="report" disabled="{{actionBusy}}">举报</button></view><view wx:else class="small">纸条经人工审核后，才会在本区域公开。</view></view></block>
  <view class="safe-note">如果正面临危险，请联系身边可信任的成人与当地紧急服务。<text>{{'\n'}}</text>树洞不提供即时救援，不开放私信与联系方式交换。</view>
</view>
<view wx:if="{{sheet}}" class="modal-mask" bindtap="closeSheet"><view class="sheet" catchtap="noop"><view class="row"><view class="section-title sheet-title">{{sheet === 'post' ? '让树洞听听你的心事' : '留一句温柔的回应'}}</view><text class="close" bindtap="closeSheet">×</text></view><scroll-view scroll-y class="sheet-scroll">
  <block wx:if="{{sheet === 'reply'}}"><view class="reply-source"><text class="small">{{selectedPost.nickname}}的纸条</text><view class="prewrap">{{selectedPost.content}}</view></view><view class="replies" wx:if="{{selectedPost.replies.length}}"><view class="reply" wx:for="{{selectedPost.replies}}" wx:key="id"><view class="small">{{item.nickname}} · {{item.displayTime}}</view><view class="prewrap">{{item.content}}</view></view></view><view wx:else class="small">还没有公开回应。可以送上第一句温暖。</view></block>
  <text class="label">这一次的化名</text><input class="field" value="{{nickname}}" data-field="nickname" bindinput="input" maxlength="20" placeholder="请勿填写真实姓名" disabled="{{submitting}}"/>
  <block wx:if="{{sheet === 'post'}}"><text class="label">纸条主题</text><picker mode="selector" range="{{topics}}" value="{{topicIndex}}" bindchange="chooseTopic" disabled="{{submitting}}"><view class="field row"><text>{{topics[topicIndex]}}</text><text>⌄</text></view></picker></block>
  <text class="label">{{sheet === 'post' ? '想写些什么？' : '我想回应……'}}</text><textarea class="field textarea" value="{{content}}" data-field="content" bindinput="input" maxlength="{{sheet === 'post' ? 1000 : 500}}" placeholder="温柔表达，不留下自己或他人的个人信息。" disabled="{{submitting}}"/><view class="count">{{content.length}} / {{sheet === 'post' ? 1000 : 500}}</view>
  <view wx:if="{{sheetError}}" class="error">{{sheetError}}</view><view class="small spaced">提交后先由工作人员审核，通过后公开。</view>
</scroll-view><button class="spaced" bindtap="submit" loading="{{submitting}}" disabled="{{submitting || !nickname || !content}}">提交审核 →</button></view></view>
