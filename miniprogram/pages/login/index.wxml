<view class="page login-page">
  <view class="brand-mark">✺</view>
  <view class="eyebrow">GROW A LITTLE, EVERY DAY</view>
  <view class="title">成长健研社</view>
  <view class="small">青少年身心健康成长服务品牌</view>
  <view class="subtitle">每一种心情，都值得被看见。<text>{{'\n'}}</text>在这里，慢慢长成自己的样子。</view>
  <view class="section-title">选择你的区域</view>
  <view wx:if="{{loading}}" class="state">正在连接成长空间…</view>
  <picker wx:else mode="selector" range="{{regions}}" range-key="name" value="{{regionIndex}}" bindchange="selectRegion" disabled="{{submitting || checking || !regions.length}}" aria-label="选择你的大区">
    <view class="field row region-picker"><text>{{regions.length ? regions[regionIndex].name : '暂未开通大区'}}</text><text class="small">选择 ⌄</text></view>
  </picker>
  <view wx:if="{{!loading && !regions.length}}" class="state">暂未开通大区，请联系平台管理员。</view>
  <view class="small">账号随学校邀请码绑定区域，请选择学校所在区域。</view>
  <view class="auth-tabs spaced">
    <view class="auth-tab {{mode === 'login' ? 'selected-tab' : ''}}" data-mode="login" bindtap="changeMode">账号登录</view>
    <view class="auth-tab {{mode === 'register' ? 'selected-tab' : ''}}" data-mode="register" bindtap="changeMode">邀请码注册</view>
  </view>
  <block wx:if="{{mode === 'register'}}">
    <text class="label">学校邀请码</text><input class="field" value="{{inviteCode}}" data-field="inviteCode" bindinput="input" placeholder="向学校老师获取" maxlength="40" disabled="{{submitting || checking}}"/>
    <view class="small">没有邀请码？请向所在学校工作人员申请。</view>
    <button class="button-outline spaced" bindtap="checkInvite" loading="{{checking}}" disabled="{{submitting || checking || !inviteCode}}">核对学校</button>
    <view wx:if="{{invitation}}" class="safe-note">将加入：{{invitation.regionName}} · {{invitation.schoolName}}。请确认是自己的学校，再设置账号和密码。</view>
    <text class="label">你的称呼</text><input class="field" value="{{name}}" data-field="name" bindinput="input" placeholder="用于自己的成长空间" maxlength="40" disabled="{{submitting}}"/>
  </block>
  <text class="label">账号</text><input class="field" value="{{account}}" data-field="account" bindinput="input" placeholder="3–40 位字母、数字、点、下划线或短横线" maxlength="40" disabled="{{submitting}}"/>
  <text class="label">密码</text><input class="field" value="{{password}}" data-field="password" bindinput="input" password placeholder="{{mode === 'register' ? '8–128 个字符' : '请输入密码'}}" maxlength="128" disabled="{{submitting}}"/>
  <block wx:if="{{mode === 'register'}}"><text class="label">确认密码</text><input class="field" value="{{confirmPassword}}" data-field="confirmPassword" bindinput="input" password placeholder="再输入一次密码" maxlength="128" disabled="{{submitting}}"/></block>
  <view wx:if="{{error}}" class="error" role="alert">{{error}}</view>
  <button class="spaced" bindtap="submit" loading="{{submitting}}" disabled="{{submitting || checking || loading || !regions.length || (mode === 'register' && !invitation)}}">{{mode === 'login' ? '进入我的成长空间' : '创建我的成长空间'}} →</button>
  <button wx:if="{{!loading && !regions.length}}" class="button-outline spaced" bindtap="load">重新连接</button>
  <view class="safe-note">日记与心情备注仅本人可见；区域老师可查看心情分数用于关怀。未成年人请与监护人共同了解学校的数据使用安排。</view>
</view>
