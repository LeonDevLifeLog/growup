<view class="page login-page">
  <view class="login-head">
    <view class="brand-mark">✺</view>
    <view>
      <view class="login-title">成长健研社</view>
      <view class="small">每一种心情，都值得被看见</view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="card state">正在连接成长空间…</view>
  <view wx:elif="{{!regions.length}}" class="card state">
    <view class="state-title">暂未开通大区</view>
    <view>请联系学校老师或平台管理员。</view>
    <view wx:if="{{error}}" class="error spaced">{{error}}</view>
    <button class="button-outline spaced" bindtap="load">重新连接</button>
  </view>

  <view wx:else class="card login-card">
    <view class="segmented">
      <view class="segment {{mode === 'login' ? 'segment-on' : ''}}" data-mode="login" bindtap="changeMode">登录</view>
      <view class="segment {{mode === 'register' ? 'segment-on' : ''}}" data-mode="register" bindtap="changeMode">邀请码注册</view>
    </view>

    <block wx:if="{{mode === 'login'}}">
      <view class="field-label">所在大区</view>
      <picker mode="selector" range="{{regions}}" range-key="name" value="{{regionIndex}}" bindchange="selectRegion" disabled="{{submitting}}">
        <view class="field row"><text>{{regions[regionIndex].name}}</text><text class="small">更换 ⌄</text></view>
      </picker>
      <view class="field-label">账号</view>
      <input class="field" value="{{account}}" data-field="account" bindinput="input" placeholder="请输入账号" maxlength="40" disabled="{{submitting}}"/>
      <view class="field-label">密码<text class="tip-btn" data-tip="forgotPassword" bindtap="showTip">?</text></view>
      <view class="field row password-field">
        <input class="password-input" value="{{password}}" data-field="password" bindinput="input" password="{{!showPassword}}" placeholder="请输入密码" maxlength="128" disabled="{{submitting}}"/>
        <text class="link" bindtap="togglePassword">{{showPassword ? '隐藏' : '显示'}}</text>
      </view>
      <view wx:if="{{error}}" class="error" role="alert">{{error}}</view>
      <button class="spaced" bindtap="submit" loading="{{submitting}}" disabled="{{submitting || !account || !password}}">进入我的成长空间 →</button>
    </block>

    <block wx:else>
      <view class="steps">
        <view class="step {{invitation ? 'step-done' : 'step-on'}}"><text class="step-num">{{invitation ? '✓' : '1'}}</text>核对学校</view>
        <view class="step-line"></view>
        <view class="step {{invitation ? 'step-on' : ''}}"><text class="step-num">2</text>设置账号</view>
      </view>

      <block wx:if="{{!invitation}}">
        <view class="field-label">学校所在大区</view>
        <picker mode="selector" range="{{regions}}" range-key="name" value="{{regionIndex}}" bindchange="selectRegion" disabled="{{checking}}">
          <view class="field row"><text>{{regions[regionIndex].name}}</text><text class="small">更换 ⌄</text></view>
        </picker>
        <view class="field-label">学校邀请码<text class="tip-btn" data-tip="invite" bindtap="showTip">?</text></view>
        <input class="field code-field" value="{{inviteCode}}" data-field="inviteCode" bindinput="input" placeholder="向本校老师索取" maxlength="40" disabled="{{checking}}"/>
        <view wx:if="{{error}}" class="error" role="alert">{{error}}</view>
        <button class="spaced" bindtap="checkInvite" loading="{{checking}}" disabled="{{checking || !inviteCode}}">核对学校 →</button>
      </block>

      <block wx:else>
        <view class="school-confirm">
          <view class="small">将加入</view>
          <view class="school-name">{{invitation.schoolName}}</view>
          <view class="small">{{invitation.regionName}}</view>
          <text class="link" bindtap="resetInvite">不是我的学校？重新填写</text>
        </view>
        <view class="field-label">怎么称呼你</view>
        <input class="field" value="{{name}}" data-field="name" bindinput="input" placeholder="用于自己的成长空间" maxlength="40" disabled="{{submitting}}"/>
        <view class="field-label">设置账号</view>
        <input class="field" value="{{account}}" data-field="account" bindinput="input" placeholder="3–40 位字母、数字、点、下划线或短横线" maxlength="40" disabled="{{submitting}}"/>
        <view class="field-label">设置密码</view>
        <view class="field row password-field">
          <input class="password-input" value="{{password}}" data-field="password" bindinput="input" password="{{!showPassword}}" placeholder="至少 8 位" maxlength="128" disabled="{{submitting}}"/>
          <text class="link" bindtap="togglePassword">{{showPassword ? '隐藏' : '显示'}}</text>
        </view>
        <view class="field-label">确认密码</view>
        <input class="field" value="{{confirmPassword}}" data-field="confirmPassword" bindinput="input" password="{{!showPassword}}" placeholder="再输入一次密码" maxlength="128" disabled="{{submitting}}"/>
        <view wx:if="{{error}}" class="error" role="alert">{{error}}</view>
        <button class="spaced" bindtap="submit" loading="{{submitting}}" disabled="{{submitting || !name || !account || !password || !confirmPassword}}">创建我的成长空间 →</button>
      </block>
    </block>
  </view>

  <view class="tip-line login-privacy">账号与隐私<text class="tip-btn" data-tip="loginPrivacy" bindtap="showTip">?</text></view>
</view>
