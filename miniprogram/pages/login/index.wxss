.login-page {
  padding-top:48rpx;
}

.login-head {
  display:flex;
  align-items:center;
  gap:24rpx;
  margin-bottom:36rpx;
}

.brand-mark {
  width:96rpx;
  height:96rpx;
  flex:none;
  border-radius:28rpx;
  background:#d5e7a7;
  display:flex;
  align-items:center;
  justify-content:center;
  color:#245c45;
  font-size:60rpx;
}

.login-title {
  font-size:40rpx;
  font-weight:700;
  color:#203229;
  margin-bottom:4rpx;
}

.login-card {
  padding:28rpx 32rpx 36rpx;
}

/* Two clearly separated modes instead of underlined text tabs. */
.segmented {
  display:flex;
  padding:6rpx;
  border-radius:20rpx;
  background:#eef2e8;
  margin-bottom:28rpx;
}

.segment {
  flex:1;
  text-align:center;
  padding:18rpx 0;
  border-radius:16rpx;
  font-size:28rpx;
  color:#6f7b6a;
}

.segment-on {
  background:#ffffff;
  color:#245c45;
  font-weight:700;
  box-shadow:0 4rpx 12rpx rgba(36,92,69,.12);
}

.field-label {
  font-size:26rpx;
  color:#4f5d52;
  margin:22rpx 0 10rpx;
}

.password-field {
  padding-top:0;
  padding-bottom:0;
}

.password-input {
  flex:1;
  height:88rpx;
}

.code-field {
  letter-spacing:4rpx;
}

.hint {
  margin-top:20rpx;
  line-height:1.7;
}

.steps {
  display:flex;
  align-items:center;
  gap:16rpx;
  margin-bottom:8rpx;
  font-size:26rpx;
  color:#9aa494;
}

.step {
  display:flex;
  align-items:center;
  gap:10rpx;
}

.step-num {
  width:40rpx;
  height:40rpx;
  border-radius:50%;
  background:#e8ede2;
  color:#7d8a78;
  font-size:22rpx;
  display:flex;
  align-items:center;
  justify-content:center;
}

.step-on {
  color:#245c45;
  font-weight:700;
}

.step-on .step-num,
.step-done .step-num {
  background:#245c45;
  color:#ffffff;
}

.step-done {
  color:#6c8a5c;
}

.step-line {
  flex:1;
  height:2rpx;
  background:#dfe5d8;
}

.school-confirm {
  margin-top:24rpx;
  padding:24rpx 28rpx;
  border-radius:20rpx;
  background:#eef5e6;
  border:2rpx solid #cfe0bd;
}

.school-name {
  font-size:32rpx;
  font-weight:700;
  color:#245c45;
  margin:6rpx 0 2rpx;
}

.school-confirm .link {
  display:inline-block;
  margin-top:12rpx;
  font-size:24rpx;
}

.login-privacy {
  justify-content:center;
}
