.login-page {
  padding-top:42rpx;
}

.brand-mark {
  width:108rpx;
  height:108rpx;
  border-radius:30rpx;
  background:#d5e7a7;
  display:flex;
  align-items:center;
  justify-content:center;
  color:#245c45;
  font-size:72rpx;
  margin-bottom:32rpx;
}

.region-picker {
  margin:18rpx 0;
}

.auth-tabs {
  display:flex;
  gap:36rpx;
  border-bottom:2rpx solid #e3e8de;
}

.auth-tab {
  padding:18rpx 2rpx;
  color:#7a857e;
  font-size:28rpx;
}

.selected-tab {
  color:#245c45;
  font-weight:700;
  border-bottom:4rpx solid #245c45;
}
