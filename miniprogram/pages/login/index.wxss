.login-page {
  padding-top:42rpx;
}

.brand-mark {
  width:108rpx;
  height:108rpx;
  border-radius:30rpx;
  background:#d5e7a7;
  display:flex;
  align-items:center;
  justify-content:center;
  color:#245c45;
  font-size:72rpx;
  margin-bottom:32rpx;
}

.regions {
  display:flex;
  gap:16rpx;
  margin:18rpx 0;
}

.region {
  flex:1;
  background:#fff;
  color:#75816e;
  text-align:left;
  padding:24rpx 20rpx;
  border:2rpx solid #e2e8dc;
  border-radius:24rpx;
}

.region.selected {
  background:#245c45;
  color:#fff;
  border-color:#245c45;
}

.region-dot {
  width:16rpx;
  height:16rpx;
  background:#d5e7a7;
  border-radius:50%;
  margin-bottom:14rpx;
}

.region-sub {
  font-weight:400;
  opacity:.7;
  font-size:20rpx;
  margin-top:8rpx;
}

.auth-tabs {
  display:flex;
  gap:36rpx;
  border-bottom:2rpx solid #e3e8de;
}

.auth-tab {
  padding:18rpx 2rpx;
  color:#7a857e;
  font-size:28rpx;
}

.selected-tab {
  color:#245c45;
  font-weight:700;
  border-bottom:4rpx solid #245c45;
}
