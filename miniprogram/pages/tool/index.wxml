<view class="page">
  <view class="row"><view class="eyebrow">STAR-TRACK · 我的成长观察</view><text class="tip-btn" data-tip="tool" bindtap="showTip">?</text></view>
  <view class="title">{{tool ? tool.name : '成长观察工具'}}</view>
  <view wx:if="{{loading}}" class="state">正在准备观察内容…</view>
  <block wx:else>
    <view wx:if="{{tool}}" class="subtitle">{{tool.description}}</view>
    <text class="label">切换观察工具</text><picker mode="selector" range="{{tools}}" range-key="name" value="{{toolIndex}}" bindchange="toolChange" disabled="{{saving || deleting}}"><view class="field row"><text>{{tool.name}}</text><text>⌄</text></view></picker>
    <view class="tool-tabs"><text class="{{tab === 'entry' ? 'selected-tab' : ''}}" data-tab="entry" bindtap="changeTab">{{tool.mode === 'questionnaire' ? '现状自评' : '记录观察'}}</text><text class="{{tab === 'history' ? 'selected-tab' : ''}}" data-tab="history" bindtap="changeTab">历史 {{records.length}}</text><text class="{{tab === 'report' ? 'selected-tab' : ''}}" data-tab="report" bindtap="changeTab">月度回顾</text></view>
    <block wx:if="{{tab === 'entry' && tool}}">
      <text class="label">适用版本 / 子页签</text><picker mode="selector" range="{{profileNames}}" value="{{profileIndex}}" bindchange="profileChange" disabled="{{saving}}"><view class="field row"><text>{{profileNames[profileIndex]}}</text><text>⌄</text></view></picker>
      <view wx:if="{{profileDescription}}" class="notice prewrap">{{profileDescription}}</view>
      <text class="label">记录日期</text><picker mode="date" value="{{date}}" end="{{today}}" bindchange="dateChange" disabled="{{saving}}"><view class="field row"><text>{{date}}</text><text>⌄</text></view></picker>
      <view wx:for="{{fields}}" wx:key="id" class="form-field">
        <view wx:if="{{item.section}}" class="field-section">{{item.section}}</view>
        <view class="label">{{index + 1}}. {{item.label}} <text wx:if="{{item.required}}" class="required">*</text><text wx:if="{{item.unit}}" class="small">（{{item.unit}}）</text></view>
        <view wx:if="{{item.description}}" class="small prewrap field-guidance">{{item.description}}</view>
        <view wx:if="{{item.help && item.help !== item.description}}" class="small prewrap field-guidance">{{item.help}}</view>
        <picker wx:if="{{item.type === 'single'}}" mode="selector" range="{{item.pickerOptions}}" range-key="label" value="{{item.selectedIndex}}" data-id="{{item.id}}" bindchange="singleChange" disabled="{{saving}}"><view class="field row"><text>{{item.selectedLabel}}</text><text>⌄</text></view></picker>
        <checkbox-group wx:elif="{{item.type === 'multi'}}" data-id="{{item.id}}" bindchange="multiChange"><label wx:for="{{item.options}}" wx:for-item="option" wx:key="key" class="checkbox-option"><checkbox value="{{option.key}}" checked="{{option.checked}}" color="#245c45" disabled="{{saving}}"/><text>{{option.label}}</text></label></checkbox-group>
        <textarea wx:elif="{{item.type === 'textarea'}}" class="field textarea" value="{{item.value}}" data-id="{{item.id}}" bindinput="fieldInput" maxlength="{{item.maxlength}}" placeholder="请填写" disabled="{{saving}}"/>
        <picker wx:elif="{{item.type === 'date' || item.type === 'time'}}" mode="{{item.type}}" value="{{item.value}}" data-id="{{item.id}}" bindchange="fieldInput" disabled="{{saving}}"><view class="field row"><text>{{item.value || '请选择'}}</text><text>⌄</text></view></picker>
        <input wx:else class="field" type="{{item.inputType}}" value="{{item.value}}" data-id="{{item.id}}" bindinput="fieldInput" maxlength="{{item.maxlength}}" placeholder="{{item.type === 'number' ? '请输入数字' : '请填写'}}" disabled="{{saving}}"/>
        <view wx:if="{{item.type === 'number'}}" class="small number-hint">{{item.min !== undefined ? '最小值 ' + item.min : ''}} {{item.max !== undefined ? '最大值 ' + item.max : ''}} {{item.step ? '步长 ' + item.step : ''}}</view>
      </view>
      <view wx:if="{{success}}" class="notice">{{success}}</view>
      <view wx:if="{{error}}" class="error">{{error}}</view>
      <button class="spaced" bindtap="save" loading="{{saving}}" disabled="{{saving || !fields.length}}">{{tool.mode === 'questionnaire' ? '保存并查看本次结果' : '保存这次成长观察'}} →</button>
      <view wx:if="{{result}}" class="report card spaced"><view class="section-title">{{result.title}}</view><view class="prewrap muted">{{result.summary}}</view><view class="metrics"><view wx:for="{{result.metrics}}" wx:key="label" class="metric"><text class="small">{{item.label}}</text><view>{{item.value}} <text class="small">{{item.unit}}</text></view><text class="small">{{item.note}}</text></view></view><view wx:for="{{result.sections}}" wx:key="title"><view class="label">{{item.title}}</view><view wx:if="{{item.text}}" class="prewrap muted">{{item.text}}</view><view wx:for="{{item.items}}" wx:for-item="line" wx:key="*this" class="report-item">· {{line}}</view></view><view wx:if="{{result.notice}}" class="notice">{{result.notice}}</view></view>
    </block>
    <block wx:elif="{{tab === 'history'}}"><view wx:if="{{!records.length}}" class="state">还没有记录，写下第一份成长观察吧。</view><view wx:for="{{records}}" wx:key="id" class="card"><view class="row"><view><view class="label record-title">{{item.date}} · {{item.profileName}}</view><view class="small">{{item.displayTime}}</view></view><text class="link" data-id="{{item.id}}" bindtap="expandRecord">{{item.expanded ? '收起' : '展开'}}</text></view><block wx:if="{{item.expanded}}"><view wx:for="{{item.entries}}" wx:for-item="entry" wx:key="id" class="history-entry"><view class="small">{{entry.label}}</view><view class="prewrap">{{entry.value}}</view></view><button wx:if="{{item.result}}" class="button-light button-small spaced" data-id="{{item.id}}" bindtap="viewResult">查看本次结果</button></block><button wx:if="{{tool.mode === 'tracker'}}" class="button-light button-small spaced" data-id="{{item.id}}" bindtap="editRecord" disabled="{{saving || deleting}}">继续编辑这次记录</button><button class="button-outline button-small spaced" data-id="{{item.id}}" bindtap="remove" disabled="{{deleting}}">删除记录</button></view></block>
    <block wx:elif="{{tab === 'report'}}"><text class="label">选择月份</text><picker mode="date" fields="month" value="{{month}}" end="{{today}}" bindchange="monthChange"><view class="field row"><text>{{month}}</text><text>⌄</text></view></picker><view wx:if="{{reportLoading}}" class="state">正在整理月度回顾…</view><view wx:elif="{{report}}" class="report card spaced"><view class="section-title">{{report.title}}</view><view class="prewrap muted">{{report.summary}}</view><view class="metrics"><view wx:for="{{report.metrics}}" wx:key="label" class="metric"><text class="small">{{item.label}}</text><view>{{item.value}} <text class="small">{{item.unit}}</text></view><text class="small">{{item.note}}</text></view></view><view wx:for="{{report.sections}}" wx:key="title"><view class="label">{{item.title}}</view><view wx:if="{{item.text}}" class="prewrap muted">{{item.text}}</view><view wx:for="{{item.items}}" wx:for-item="line" wx:key="*this" class="report-item">· {{line}}</view></view><view class="notice">{{report.notice}}</view></view><button wx:else class="button-light spaced" bindtap="loadReport">生成月度回顾</button></block>
  </block>
  <view wx:if="{{error && (tab !== 'entry' || !tool)}}" class="error">{{error}}<button wx:if="{{!tool}}" class="button-outline button-small spaced" bindtap="load">重试</button></view>
</view>
