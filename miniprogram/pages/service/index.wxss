.form-field { margin-top:30rpx; }
.field-section { font-weight:600; color:#567845; padding:18rpx 22rpx; background:#e9efdf; border-radius:16rpx; }
.checkbox-option { display:flex; align-items:center; gap:16rpx; padding:18rpx 20rpx; border:1rpx solid #e1e7dc; border-radius:18rpx; margin-bottom:12rpx; background:#fff; }
.checkbox-option text { flex:1; font-size:26rpx; }
