{
  "name": "sunward-growup",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "demo": "node scripts/demo.mjs",
    "start": "node server/index.mjs",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/server/*.test.mjs",
    "test:ui": "node tests/browser.mjs",
    "test:ui:migration": "node tests/migration-browser.mjs",
    "test:ui:enrollment": "node tests/enrollment-browser.mjs",
    "test:mini:enrollment": "node tests/mini-enrollment.mjs",
    "test:docker": "node tests/docker-smoke.mjs",
    "test:docker:fresh": "node tests/fresh-install.mjs",
    "check:mini": "node miniprogram/validate.mjs",
    "check": "npm run build && npm test && npm run check:mini",
    "format": "prettier --write web server scripts tests vite.config.js package.json"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "prettier": "^3.9.10",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
